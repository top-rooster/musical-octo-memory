{
  "body": {
    "name": "Body",
    "image": "images/body.png",
    "description": "Nadir's physical condition and basic survival needs.",
    "markers": ["anchored"],
    "values": { "hydration": 50, "satiation": 50 },
    "processes": [
      {
        "interval": "15m",
        "effects": [{ "change": "hydration", "amount": -2 }]
      }
    ],
    "when": [
      { "value": "hydration", "equals": 0, "effects": [{ "gameOver": true }] },
      { "value": "satiation", "equals": 0, "effects": [{ "gameOver": true }] }
    ]
  },
  "mind": {
    "name": "Mind",
    "image": "images/mind.png",
    "description": "Nadir's perception and mental state.",
    "markers": ["anchored"],
    "values": { "vision": 4 }
  },
  "spirit": {
    "name": "Spirit",
    "image": "images/spirit.png",
    "description": "Nadir's emotional and spiritual state.",
    "markers": ["anchored"]
  },
  "exhausted": {
    "name": "Exhausted",
    "image": "images/exhausted.png",
    "description": "Nadir is too exhausted to function normally.",
    "markers": ["anchored"],
    "accept": [
      {
        "card": "body",
        "action": { "time": "8h", "effects": [{ "discard": "source" }] }
      }
    ]
  },
  "flesh-wound": {
    "name": "Flesh Wound",
    "image": "images/flesh-wound.png",
    "description": "An open injury that can heal or become infected.",
    "markers": ["anchored"],
    "values": { "infection": 50 },
    "processes": [
      {
        "interval": "15m",
        "change": "progress",
        "amountByValue": {
          "value": "infection",
          "ranges": [
            { "from": 0, "to": 24, "amount": 2 },
            { "from": 25, "to": 49, "amount": 1 },
            { "from": 50, "to": 74, "amount": 0 },
            { "from": 75, "to": 100, "amount": -1 }
          ]
        },
        "when": [{ "value": "progress", "equals": 100, "effects": [{ "discard": "self" }] }]
      }
    ],
    "accept": [
      {
        "markers": ["contains-water"],
        "action": {
          "time": "15m",
          "effects": [
            { "change": "infection", "target": "receiver", "amount": -40 },
            { "remove": "contains-water", "target": "source" }
          ]
        }
      },
      {
        "markers": ["fabric", "sterilized"],
        "action": {
          "time": "15m",
          "effects": [
            { "discard": "source" },
            { "add": "dressed", "target": "receiver" }
          ]
        }
      }
    ]
  },
  "burn-wound": {
    "name": "Burn Wound",
    "image": "images/burn-wound.png",
    "description": "A burn injury requiring treatment and time to heal.",
    "markers": ["anchored"],
    "values": { "infection": 50 },
    "accept": [
      {
        "markers": ["contains-water"],
        "action": {
          "time": "15m",
          "effects": [
            { "change": "infection", "target": "receiver", "amount": -40 },
            { "remove": "contains-water", "target": "source" }
          ]
        }
      },
      {
        "markers": ["fabric", "sterilized"],
        "action": {
          "time": "15m",
          "effects": [
            { "discard": "source" },
            { "add": "dressed", "target": "receiver" }
          ]
        }
      }
    ]
  },
  "fever": {
