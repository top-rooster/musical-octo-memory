{
  "body": {
    "name": "Body",
    "image": "images/body.png",
    "description": "Nadir's physical condition and basic survival needs.",
    "markers": ["anchored"],
    "values": { "hydration": 50, "satiation": 50 },
    "actions": [
      {
        "id": "travel",
        "name": "Travel",
        "applicable": { "on": { "target": "other", "marker": "path" } },
        "effects": [
          { "spend-time": { "target": "other", "value": "travel-time" } },
          { "set-room": { "target": "other", "reference": "destination" } }
        ]
      },
      {
        "id": "eat",
        "name": "Eat",
        "applicable": { "receive": { "target": "other", "marker": "food" } },
        "effects": [
          { "spend-time": 0 },
          { "target": "self", "value": "satiation", "+=": { "target": "other", "value": "food-value" } },
          { "target": "other", "discard": true }
        ]
      },
      {
        "id": "drink",
        "name": "Drink",
        "applicable": {
          "receive": {
            "and": [
              { "target": "other", "marker": "hydration" },
              { "target": "other", "marker": "contains-water" }
            ]
          }
        },
        "effects": [
          { "spend-time": 0 },
          { "target": "self", "value": "hydration", "+=": { "target": "other", "value": "hydration-value" } },
          { "target": "other", "remove-marker": "contains-water" }
        ]
      }
    ],
    "processes": [
      {
        "effects": [
          { "value": "hydration", "-=": 2 },
          { "value": "satiation", "-=": 1 }
        ]
      }
    ]
  },
